# ==========================================
# Configuración de Base de Datos (SQLite)
# ==========================================
DB_PATH=database/samgy.sqlite

# ==========================================
# Configuración del Backend (Node.js >= 22.5)
# ==========================================
PORT=3000
NODE_ENV=development
JWT_SECRET=cambiar_por_secreto_jwt_aleatorio_largo_min_32_caracteres
JWT_EXPIRES_IN=8h
# Límite general de peticiones (100 peticiones cada 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Ruta personalizada de archivos estáticos (opcional, por defecto ../frontend)
# FRONTEND_PATH=../frontend

# ==========================================
# Administrador de Arranque Inicial
# ==========================================
ADMIN_CORREO=admin@sanalbertomagno.edu.co
ADMIN_PASSWORD=cambiar_por_clave_admin_segura_min_10_caracteres
